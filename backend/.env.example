# ============================
# CONFIGURACIÓN DEL SERVIDOR
# ============================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================
# SUPABASE (Base de Datos)
# ============================
# Crear cuenta gratuita en https://supabase.com
# Ir a Settings > API para obtener estos valores
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ============================
# JWT (Autenticación Admin)
# ============================
JWT_SECRET=cambia-esto-por-un-secreto-muy-largo-y-seguro-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# ============================
# MERCADO PAGO
# ============================
# Crear cuenta en https://www.mercadopago.com.ar/developers
# Ir a Tus integraciones > Credenciales
MP_ACCESS_TOKEN=TEST-tu-access-token-aqui
MP_PUBLIC_KEY=TEST-tu-public-key-aqui
# Cambiar a producción cuando estés listo:
# MP_ACCESS_TOKEN=APP_USR-tu-token-produccion

# ============================
# QR CODE
# ============================
# URL pública del frontend (para el QR del menú)
PUBLIC_MENU_URL=http://localhost:5173/menu

# ============================
# CONFIGURACIÓN DEL NEGOCIO
# ============================
BUSINESS_NAME=Mi Cafetería
BUSINESS_ADDRESS=Av. Principal 123, Ciudad
BUSINESS_PHONE=+54 9 11 1234-5678
BUSINESS_EMAIL=info@micafeteria.com
